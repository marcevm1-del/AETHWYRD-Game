# .NET build output
bin/
obj/

# Generated by `npm run gen` (rebuild locally; JSON stays committed)
08_Bestiary/bestiary_viewer.html
Data/Monsters/*.csv

# .NET build output (redirected by Code/Directory.Build.props)
Code/.build/

# Unity-generated IDE files
Game/*.csproj
Game/*.sln
Game/*.slnx
Game/.vs/
Game/.idea/

# Blender auto-backups
*.blend1

# Local vault backups (not part of the generated vault)
ideas/_ascend_ideas_preserve_*/

# AI-generated monster models stay on this PC (too large for GitHub's free LFS); their info is in
# Art/Generation/monster_models.json. The Ring 0 models in the Monsters folder root stay tracked.
Game/Assets/_Game/Art/Models/Monsters/*/
Game/Assets/_Game/Art/Models/Monsters/*.meta
!Game/Assets/_Game/Art/Models/Monsters/*.fbx.meta

# The repo folder is also the Obsidian vault (2026-10-24): keep personal vault config and the nested repo
# clones out of the game repo. Notes, canvases and daily notes stay tracked.
.obsidian/
.claudian/
GitHub/Aetheria-Game/
GitHub/Project-Greyborn/
GitHub/Project-lili/
GitHub/Teacher-OS/

# Regional building libraries: generated by Tools/blender/build_building_library.py (about 40 MB per region).
# The catalog file and the contact sheets in 13_Production/screenshots/buildings stay tracked.
Art/Blender/BuildingLibrary/*.blend
Art/Blender/BuildingLibrary/*.blend1
Art/Blender/BuildingLibrary/_previews/
# Third-party CC0 packs, extracted and imported locally by Tools/blender/import_cc0_packs.py.
Art/ThirdParty/
Art/Blender/AssetLibrary_CC0/*.blend
Art/Blender/AssetLibrary_CC0/*.blend1
Art/Blender/AssetLibrary_CC0/_previews/
__pycache__/
# Creature libraries: generated by Tools/blender/build_creature_library.py (about 250 MB per family, high-poly).
Art/Blender/CreatureLibrary/*.blend
Art/Blender/CreatureLibrary/*.blend1
Art/Blender/CreatureLibrary/_previews/
# Rigged creatures: generated by Tools/blender/rig_creature.py (about 10-15 MB each)
Art/Blender/Rigged/
