<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure game rules: no UnityEngine references. Unity 6 supports .NET Standard 2.1 and C# 9,
       so this source can be dropped into Assets/_Game/Code/Core with a noEngineReferences asmdef. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Ascend.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
