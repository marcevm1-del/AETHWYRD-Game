{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Human character library",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "notes",
  "rig",
  "bodies",
  "builds",
  "ages",
  "palettes",
  "hairStyles",
  "outfits",
  "variants"
 ],
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "notes": {
   "type": "string"
  },
  "rig": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "requiredBones",
    "extraBones",
    "maxInfluences",
    "headsTall"
   ],
   "properties": {
    "requiredBones": {
     "type": "array",
     "minItems": 52,
     "maxItems": 52,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z]+$"
     }
    },
    "extraBones": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z_0-9]+$"
     }
    },
    "maxInfluences": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4
    },
    "headsTall": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "type": "number",
      "minimum": 5,
      "maximum": 9
     }
    }
   }
  },
  "bodies": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "sex",
     "label",
     "heightM",
     "heightBand",
     "headsTall",
     "shoulderHalf",
     "chestHalf",
     "waistHalf",
     "hipHalf",
     "chestDepth",
     "neckHalf",
     "headHalf",
     "hipJointZ",
     "upperArmLen",
     "foreArmLen",
     "handLen",
     "thighHalf",
     "calfHalf",
     "ankleHalf",
     "footLen",
     "eyeWidth",
     "eyeHeightRatio"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "sex": {
      "enum": [
       "male",
       "female"
      ]
     },
     "label": {
      "type": "string"
     },
     "heightM": {
      "type": "number",
      "minimum": 1.3,
      "maximum": 2.2
     },
     "heightBand": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "number",
       "minimum": 1.3,
       "maximum": 2.2
      }
     },
     "headsTall": {
      "type": "number",
      "minimum": 6.5,
      "maximum": 7.5
     },
     "shoulderHalf": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 0.2
     },
     "chestHalf": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 0.2
     },
     "waistHalf": {
      "type": "number",
      "minimum": 0.04,
      "maximum": 0.2
     },
     "hipHalf": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 0.2
     },
     "chestDepth": {
      "type": "number",
      "minimum": 0.03,
      "maximum": 0.1
     },
     "neckHalf": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 0.06
     },
     "headHalf": {
      "type": "number",
      "minimum": 0.03,
      "maximum": 0.07
     },
     "hipJointZ": {
      "type": "number",
      "minimum": 0.45,
      "maximum": 0.56
     },
     "upperArmLen": {
      "type": "number",
      "minimum": 0.12,
      "maximum": 0.22
     },
     "foreArmLen": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 0.2
     },
     "handLen": {
      "type": "number",
      "minimum": 0.06,
      "maximum": 0.12
     },
     "thighHalf": {
      "type": "number",
      "minimum": 0.03,
      "maximum": 0.08
     },
     "calfHalf": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 0.06
     },
     "ankleHalf": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 0.04
     },
     "footLen": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 0.18
     },
     "eyeWidth": {
      "type": "number",
      "minimum": 0.15,
      "maximum": 0.3
     },
     "eyeHeightRatio": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 1
     }
    }
   }
  },
  "builds": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "label",
     "girth",
     "shoulders",
     "waist",
     "limbs"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "label": {
      "type": "string"
     },
     "girth": {
      "type": "number",
      "minimum": 0.7,
      "maximum": 1.3
     },
     "shoulders": {
      "type": "number",
      "minimum": 0.7,
      "maximum": 1.3
     },
     "waist": {
      "type": "number",
      "minimum": 0.7,
      "maximum": 1.3
     },
     "limbs": {
      "type": "number",
      "minimum": 0.7,
      "maximum": 1.3
     }
    }
   }
  },
  "ages": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "label",
     "headScale",
     "eyeScale",
     "jaw",
     "stoop",
     "browDrop"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "label": {
      "type": "string"
     },
     "headScale": {
      "type": "number",
      "minimum": 0.9,
      "maximum": 1.1
     },
     "eyeScale": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.2
     },
     "jaw": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 1.2
     },
     "stoop": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.05
     },
     "browDrop": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.01
     }
    }
   }
  },
  "palettes": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "skin",
    "hair",
    "eyes",
    "outfit"
   ],
   "properties": {
    "skin": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "label",
       "hex",
       "blush"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
       },
       "label": {
        "type": "string"
       },
       "hex": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       },
       "blush": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       }
      }
     }
    },
    "hair": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "label",
       "hex",
       "tip"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
       },
       "label": {
        "type": "string"
       },
       "hex": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       },
       "tip": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       }
      }
     }
    },
    "eyes": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "label",
       "hex"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
       },
       "label": {
        "type": "string"
       },
       "hex": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       }
      }
     }
    },
    "outfit": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "label",
       "primary",
       "secondary",
       "trim",
       "leather",
       "cloak"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
       },
       "label": {
        "type": "string"
       },
       "primary": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       },
       "secondary": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       },
       "trim": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       },
       "leather": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       },
       "cloak": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       }
      }
     }
    }
   }
  },
  "hairStyles": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "body",
     "label"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "body": {
      "enum": [
       "male",
       "female",
       "any"
      ]
     },
     "label": {
      "type": "string"
     }
    }
   }
  },
  "outfits": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "body",
     "label",
     "parts"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "body": {
      "enum": [
       "male",
       "female"
      ]
     },
     "label": {
      "type": "string"
     },
     "parts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
       "enum": [
        "top",
        "bottom",
        "skirt",
        "belt",
        "boots",
        "bracers",
        "cloak"
       ]
      }
     },
     "top": {
      "type": "object"
     },
     "bottom": {
      "type": "object"
     }
    }
   }
  },
  "variants": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "body",
     "seed",
     "heightM",
     "build",
     "age",
     "skin",
     "hair",
     "eyes",
     "outfit"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "body": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "isBase": {
      "type": "boolean"
     },
     "seed": {
      "type": "integer",
      "minimum": 0
     },
     "heightM": {
      "type": "number",
      "minimum": 1.3,
      "maximum": 2.2
     },
     "build": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "age": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "skin": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "hair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "style",
       "colour"
      ],
      "properties": {
       "style": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
       },
       "colour": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
       }
      }
     },
     "eyes": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "outfit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "colours"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
       },
       "colours": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
       }
      }
     },
     "cloak": {
      "type": "boolean"
     },
     "earLength": {
      "type": "number",
      "minimum": 0.8,
      "maximum": 2
     }
    }
   }
  }
 }
}