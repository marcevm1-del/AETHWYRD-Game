{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Population variant",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "name",
  "speciesId",
  "regionId",
  "tier",
  "rank",
  "level",
  "size",
  "ring",
  "look",
  "spawn"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^pop_[0-9]{5}$"
  },
  "name": {
   "type": "string"
  },
  "speciesId": {
   "type": "string",
   "pattern": "^mon_[a-z0-9_]+$"
  },
  "regionId": {
   "type": "string",
   "pattern": "^reg_[a-z0-9_]+$"
  },
  "region": {
   "type": "string"
  },
  "tier": {
   "type": "string",
   "enum": [
    "Runt",
    "Juvenile",
    "Adult",
    "Scarred",
    "Alpha",
    "Albino",
    "Elderborn",
    "Unique"
   ]
  },
  "rank": {
   "type": "string",
   "pattern": "^(F|E|D|C|B|A|S|SS|SSS|EX)[+-]?$"
  },
  "level": {
   "type": "integer",
   "minimum": 1,
   "maximum": 300
  },
  "size": {
   "type": "number"
  },
  "ring": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9
  },
  "look": {
   "type": "string"
  },
  "spawn": {
   "type": "string",
   "enum": [
    "Day",
    "Night",
    "Day & Night",
    "Story"
   ]
  }
 }
}