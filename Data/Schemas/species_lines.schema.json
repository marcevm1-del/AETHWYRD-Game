{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Species to evolution line assignments",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "notes",
  "methods",
  "unassigned",
  "assignments"
 ],
 "properties": {
  "notes": {
   "type": "string",
   "minLength": 1
  },
  "methods": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0,
    "maximum": 1000
   }
  },
  "unassigned": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^mon_[a-z0-9_]+$"
   }
  },
  "assignments": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "speciesId",
     "lineId",
     "stage",
     "method"
    ],
    "properties": {
     "speciesId": {
      "type": "string",
      "pattern": "^mon_[a-z0-9_]+$"
     },
     "lineId": {
      "type": "string",
      "pattern": "^evl_[a-z0-9_]+$"
     },
     "stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
     },
     "method": {
      "type": "string",
      "enum": [
       "name",
       "keyword",
       "family",
       "base"
      ]
     }
    }
   }
  }
 }
}