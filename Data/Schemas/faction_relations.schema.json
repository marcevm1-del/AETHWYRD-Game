{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Player and monster-group relations",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "notes",
  "playerStates",
  "startingStandingPoints",
  "groups",
  "exampleRule"
 ],
 "properties": {
  "notes": {
   "type": "string",
   "minLength": 1
  },
  "exampleRule": {
   "type": "string",
   "minLength": 1
  },
  "playerStates": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "minPoints",
     "text"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "minPoints": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100
     },
     "text": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "startingStandingPoints": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": -100,
    "maximum": 100
   }
  },
  "groups": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "lineId",
     "defaultState",
     "allyLines",
     "rivalLines",
     "note"
    ],
    "properties": {
     "lineId": {
      "type": "string",
      "pattern": "^evl_[a-z0-9_]+$"
     },
     "defaultState": {
      "type": "string",
      "enum": [
       "Hostile",
       "Wary",
       "Neutral",
       "Friendly",
       "Allied"
      ]
     },
     "allyLines": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^evl_[a-z0-9_]+$"
      }
     },
     "rivalLines": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^evl_[a-z0-9_]+$"
      }
     },
     "note": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}