{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Civilization Archive",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "notes",
  "civilizations",
  "sites",
  "entries",
  "fragments"
 ],
 "properties": {
  "notes": {
   "type": "string"
  },
  "civilizations": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "age",
     "source",
     "summary"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^civ_[a-z0-9_]+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "age": {
      "type": "string",
      "minLength": 1
     },
     "source": {
      "type": "string",
      "minLength": 3
     },
     "summary": {
      "type": "string",
      "minLength": 20
     }
    }
   }
  },
  "sites": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "regionId",
     "name",
     "civilizationId",
     "loreStatus"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^site_[a-z0-9_]+$"
     },
     "regionId": {
      "type": "string",
      "pattern": "^reg_[a-z0-9_]+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "civilizationId": {
      "type": "string",
      "pattern": "^civ_[a-z0-9_]+$"
     },
     "loreStatus": {
      "type": "string",
      "enum": [
       "canon",
       "draft"
      ]
     }
    }
   }
  },
  "entries": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "civilizationId",
     "kind",
     "title",
     "text",
     "source",
     "how",
     "draft"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^ent_[a-z0-9_]+$"
     },
     "civilizationId": {
      "type": "string",
      "pattern": "^civ_[a-z0-9_]+$"
     },
     "kind": {
      "type": "string",
      "enum": [
       "manuscript",
       "inscription",
       "painting",
       "machine",
       "record",
       "object",
       "map"
      ]
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "text": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400
     },
     "source": {
      "type": "string",
      "minLength": 3
     },
     "how": {
      "type": "string",
      "enum": [
       "read",
       "restore"
      ]
     },
     "readAt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "siteId": {
        "type": "string",
        "pattern": "^site_[a-z0-9_]+$"
       },
       "dungeonId": {
        "type": "string",
        "pattern": "^dng_[a-z0-9_]+$"
       },
       "roomId": {
        "type": "string",
        "pattern": "^rm_[a-z0-9_]+$"
       },
       "clueId": {
        "type": "string",
        "pattern": "^clue_[a-z0-9_]+$"
       }
      }
     },
     "hearsClues": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "dungeonId",
        "clueId"
       ],
       "properties": {
        "dungeonId": {
         "type": "string",
         "pattern": "^dng_[a-z0-9_]+$"
        },
        "clueId": {
         "type": "string",
         "pattern": "^clue_[a-z0-9_]+$"
        }
       }
      }
     },
     "hearsRegions": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^reg_[a-z0-9_]+$"
      }
     },
     "artifact": {
      "type": "string"
     },
     "draft": {
      "type": "boolean"
     }
    }
   }
  },
  "fragments": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "itemId",
     "name",
     "entryId",
     "foundIn",
     "draft"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^frag_[a-z0-9_]+$"
     },
     "itemId": {
      "type": "string",
      "pattern": "^itm_frag_[a-z0-9_]+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "entryId": {
      "type": "string",
      "pattern": "^ent_[a-z0-9_]+$"
     },
     "foundIn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "siteId": {
        "type": "string",
        "pattern": "^site_[a-z0-9_]+$"
       },
       "dungeonId": {
        "type": "string",
        "pattern": "^dng_[a-z0-9_]+$"
       },
       "roomId": {
        "type": "string",
        "pattern": "^rm_[a-z0-9_]+$"
       },
       "clueId": {
        "type": "string",
        "pattern": "^clue_[a-z0-9_]+$"
       }
      }
     },
     "draft": {
      "type": "boolean"
     }
    }
   }
  }
 }
}