{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Spell thread (Loom, proposed)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "name",
  "kind",
  "group",
  "strain",
  "categories",
  "disciplines",
  "minRank",
  "hold",
  "trigger",
  "element",
  "effect",
  "status"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^thr_[a-z0-9_]+$"
  },
  "name": {
   "type": "string",
   "minLength": 1
  },
  "kind": {
   "type": "string",
   "enum": [
    "shape",
    "power",
    "attune",
    "trigger"
   ]
  },
  "group": {
   "type": "string",
   "enum": [
    "weave",
    "bond",
    "faith",
    "frayed",
    "any"
   ]
  },
  "strain": {
   "type": "number",
   "minimum": 0.5,
   "maximum": 2
  },
  "categories": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "enum": [
     "Strike",
     "Barrage",
     "Ward",
     "Binding",
     "Mobility",
     "Sensing",
     "Mending",
     "Empowerment",
     "Hex",
     "Illusion",
     "Pact",
     "Utility"
    ]
   }
  },
  "disciplines": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "minRank": {
   "type": "string",
   "enum": [
    "F",
    "E",
    "D",
    "C",
    "B",
    "A",
    "S",
    "SS",
    "SSS",
    "EX"
   ]
  },
  "hold": {
   "type": "integer",
   "minimum": 0
  },
  "trigger": {
   "type": "string"
  },
  "element": {
   "type": "string",
   "enum": [
    "None",
    "Fire",
    "Water",
    "Ice",
    "Lightning",
    "Earth",
    "Wind",
    "Nature",
    "Poison",
    "Light",
    "Dark",
    "Blood",
    "Void"
   ]
  },
  "effect": {
   "type": "string",
   "minLength": 1
  },
  "status": {
   "type": "string",
   "enum": [
    "proposed",
    "approved"
   ]
  }
 }
}