{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Loot table",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "entries"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^loot_[a-z0-9_]+$"
  },
  "family": {
   "type": "string"
  },
  "rank": {
   "type": "string",
   "enum": [
    "F",
    "E",
    "D",
    "C",
    "B",
    "A",
    "S",
    "SS",
    "SSS",
    "EX"
   ]
  },
  "entries": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "itemId",
     "weight",
     "min",
     "max"
    ],
    "properties": {
     "itemId": {
      "type": "string",
      "pattern": "^itm_[a-z0-9_]+$"
     },
     "weight": {
      "type": "integer",
      "minimum": 1
     },
     "min": {
      "type": "integer",
      "minimum": 0
     },
     "max": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  }
 }
}