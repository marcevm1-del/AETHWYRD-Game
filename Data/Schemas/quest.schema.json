{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Quest",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "title",
  "rank",
  "type",
  "giver",
  "region",
  "objectives",
  "rewards"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^qst_[a-z0-9_]+$"
  },
  "title": {
   "type": "string"
  },
  "rank": {
   "type": "string",
   "pattern": "^(F|E|D|C|B|A|S|SS|SSS|EX)[+-]?$"
  },
  "type": {
   "type": "string",
   "enum": [
    "Main",
    "Subjugation",
    "Gathering",
    "Escort",
    "Delivery",
    "Investigation",
    "Exploration",
    "Defense",
    "SiegeDefence",
    "Capture",
    "Bounty",
    "Dungeon",
    "OddJob",
    "Trial",
    "Faction",
    "Companion",
    "Class",
    "Hidden",
    "Divine"
   ]
  },
  "giver": {
   "type": "string",
   "pattern": "^npc_[a-z0-9_]+$"
  },
  "region": {
   "type": "string",
   "pattern": "^reg_[a-z0-9_]+$"
  },
  "summary": {
   "type": "string"
  },
  "regionState": {
   "type": "string",
   "enum": [
    "any",
    "besieged",
    "liberated"
   ]
  },
  "requirements": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "minLevel": {
     "type": "integer",
     "minimum": 1,
     "maximum": 300
    },
    "partySize": {
     "type": "string"
    }
   }
  },
  "prerequisites": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "quests": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^qst_[a-z0-9_]+$"
     }
    },
    "flags": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     }
    },
    "act": {
     "type": "integer",
     "minimum": 0,
     "maximum": 6
    },
    "rank": {
     "type": "string",
     "enum": [
      "F",
      "E",
      "D",
      "C",
      "B",
      "A",
      "S",
      "SS",
      "SSS",
      "EX"
     ]
    }
   }
  },
  "setsFlags": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9_]*$"
   }
  },
  "objectives": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "kind"
    ],
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "kill",
       "collect",
       "talk",
       "escort",
       "reach",
       "defend",
       "tame",
       "choice"
      ]
     },
     "target": {
      "type": "string"
     },
     "count": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  },
  "rewards": {
   "type": "object",
   "properties": {
    "gold": {
     "type": "integer",
     "minimum": 0
    },
    "gp": {
     "type": "integer",
     "minimum": 0
    },
    "xp": {
     "type": "integer",
     "minimum": 0
    },
    "items": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^itm_[a-z0-9_]+$"
     }
    }
   }
  }
 }
}