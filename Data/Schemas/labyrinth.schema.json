{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Great Labyrinth floor registry (Wave F-lite)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "id",
  "entrance",
  "floorCount",
  "bands",
  "decades",
  "floors",
  "stairs",
  "backDoors"
 ],
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "note": {
   "type": "string"
  },
  "id": {
   "type": "string",
   "enum": [
    "great_labyrinth"
   ]
  },
  "entrance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "regionId",
    "text",
    "mapAt"
   ],
   "properties": {
    "regionId": {
     "type": "string",
     "pattern": "^reg_[a-z0-9_]+$"
    },
    "text": {
     "type": "string",
     "minLength": 1
    },
    "mapAt": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "type": "number",
      "minimum": 0,
      "maximum": 150
     }
    }
   }
  },
  "floorCount": {
   "type": "integer",
   "enum": [
    120
   ]
  },
  "resets": {
   "type": "string",
   "enum": [
    "weekly"
   ]
  },
  "startHeard": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 1,
    "maximum": 120
   }
  },
  "bands": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "regionId",
     "floors",
     "licenceRank",
     "settlement",
     "name",
     "rankMin",
     "rankMax",
     "ring"
    ],
    "properties": {
     "id": {
      "type": "string",
      "enum": [
       "upper",
       "deep",
       "abyss"
      ]
     },
     "regionId": {
      "type": "string",
      "pattern": "^reg_[a-z0-9_]+$"
     },
     "floors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "integer",
       "minimum": 1,
       "maximum": 120
      }
     },
     "licenceRank": {
      "type": "string",
      "enum": [
       "F",
       "E",
       "D",
       "C",
       "B",
       "A",
       "S",
       "SS",
       "SSS",
       "EX"
      ]
     },
     "settlement": {
      "type": "string",
      "enum": [
       "towns",
       "camps",
       "none"
      ]
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "rankMin": {
      "type": "string",
      "enum": [
       "F",
       "E",
       "D",
       "C",
       "B",
       "A",
       "S",
       "SS",
       "SSS",
       "EX"
      ]
     },
     "rankMax": {
      "type": "string",
      "enum": [
       "F",
       "E",
       "D",
       "C",
       "B",
       "A",
       "S",
       "SS",
       "SSS",
       "EX"
      ]
     },
     "ring": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
     }
    }
   }
  },
  "decades": {
   "type": "array",
   "minItems": 12,
   "maxItems": 12,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "floors",
     "biome",
     "rankMin",
     "rankMax"
    ],
    "properties": {
     "floors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "integer",
       "minimum": 1,
       "maximum": 120
      }
     },
     "biome": {
      "type": "string",
      "minLength": 1
     },
     "rankMin": {
      "type": "string",
      "pattern": "^(F|E|D|C|B|A|S|SS|SSS|EX)[+-]?$"
     },
     "rankMax": {
      "type": "string",
      "pattern": "^(F|E|D|C|B|A|S|SS|SSS|EX)[+-]?$"
     },
     "hidden": {
      "type": "boolean"
     },
     "secret": {
      "type": "boolean"
     }
    }
   }
  },
  "floors": {
   "type": "array",
   "minItems": 120,
   "maxItems": 120,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "n",
     "band",
     "biome",
     "rankMin",
     "rankMax",
     "guardian"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^flr_\\d{3}$"
     },
     "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
     },
     "band": {
      "type": "string",
      "enum": [
       "upper",
       "deep",
       "abyss"
      ]
     },
     "biome": {
      "type": "string",
      "minLength": 1
     },
     "rankMin": {
      "type": "string",
      "pattern": "^(F|E|D|C|B|A|S|SS|SSS|EX)[+-]?$"
     },
     "rankMax": {
      "type": "string",
      "pattern": "^(F|E|D|C|B|A|S|SS|SSS|EX)[+-]?$"
     },
     "guardian": {
      "type": "boolean"
     },
     "safe": {
      "type": "string",
      "enum": [
       "town",
       "camp"
      ]
     },
     "safeSource": {
      "type": "string",
      "enum": [
       "gazetteer",
       "inferred"
      ]
     },
     "hidden": {
      "type": "boolean"
     },
     "secret": {
      "type": "boolean"
     },
     "landmarks": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "dungeonIds": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^dng_[a-z0-9_]+$"
      }
     }
    }
   }
  },
  "stairs": {
   "type": "array",
   "minItems": 119,
   "maxItems": 119,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "from",
     "to"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^stair_\\d{3}_\\d{3}$"
     },
     "from": {
      "type": "integer",
      "minimum": 1,
      "maximum": 119
     },
     "to": {
      "type": "integer",
      "minimum": 2,
      "maximum": 120
     },
     "hidden": {
      "type": "boolean"
     },
     "licenceRank": {
      "type": "string",
      "enum": [
       "F",
       "E",
       "D",
       "C",
       "B",
       "A",
       "S",
       "SS",
       "SSS",
       "EX"
      ]
     }
    }
   }
  },
  "backDoors": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "floor",
     "layer",
     "regionId",
     "hidden",
     "pairing"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^bd_\\d{3}$"
     },
     "floor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
     },
     "layer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "regionId": {
      "type": "string",
      "pattern": "^reg_[a-z0-9_]+$"
     },
     "hidden": {
      "type": "boolean",
      "enum": [
       true
      ]
     },
     "pairing": {
      "type": "string",
      "enum": [
       "canon",
       "inferred"
      ]
     }
    }
   }
  }
 }
}