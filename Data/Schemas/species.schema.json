{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Monster species",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "name",
  "familyKey",
  "family",
  "type",
  "tier",
  "rank",
  "level",
  "menace",
  "element",
  "sizeMeters",
  "rigId",
  "animSetId",
  "behavior",
  "aiPattern",
  "stats",
  "xp",
  "gold",
  "attackIds",
  "isUnique",
  "ring",
  "habitats",
  "lootTableId",
  "look",
  "designRecipe"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^mon_[a-z0-9_]+$"
  },
  "name": {
   "type": "string",
   "minLength": 1
  },
  "familyKey": {
   "type": "string"
  },
  "family": {
   "type": "string"
  },
  "type": {
   "type": "string"
  },
  "genre": {
   "type": "string"
  },
  "tier": {
   "type": "string",
   "enum": [
    "core",
    "variant"
   ]
  },
  "variantKind": {
   "type": "string",
   "enum": [
    "",
    "elemental",
    "elder",
    "corrupted",
    "ancient",
    "spirit",
    "regional"
   ]
  },
  "baseSpeciesId": {
   "type": "string"
  },
  "rank": {
   "type": "string",
   "pattern": "^(F|E|D|C|B|A|S|SS|SSS|EX)[+-]?$"
  },
  "level": {
   "type": "integer",
   "minimum": 1,
   "maximum": 300
  },
  "levelRange": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "items": {
    "type": "integer",
    "minimum": 1,
    "maximum": 300
   }
  },
  "bossHpMult": {
   "type": "number",
   "minimum": 1
  },
  "menace": {
   "type": "integer",
   "minimum": 1,
   "maximum": 5
  },
  "menaceLabel": {
   "type": "string"
  },
  "element": {
   "type": "string",
   "enum": [
    "None",
    "Fire",
    "Water",
    "Ice",
    "Lightning",
    "Earth",
    "Wind",
    "Nature",
    "Poison",
    "Light",
    "Dark",
    "Blood",
    "Void"
   ]
  },
  "weakness": {
   "type": "string",
   "enum": [
    "None",
    "Fire",
    "Water",
    "Ice",
    "Lightning",
    "Earth",
    "Wind",
    "Nature",
    "Poison",
    "Light",
    "Dark",
    "Blood",
    "Void"
   ]
  },
  "sizeMeters": {
   "type": "number",
   "minimum": 0
  },
  "rigId": {
   "type": "string",
   "pattern": "^rig_[a-z0-9_]+$"
  },
  "animSetId": {
   "type": "string",
   "pattern": "^anim_[a-z0-9_]+$"
  },
  "behavior": {
   "type": "string",
   "enum": [
    "Passive",
    "Territorial",
    "Swarm",
    "Pack",
    "Ambush",
    "Aggressive",
    "Skittish",
    "Guardian"
   ]
  },
  "aiPattern": {
   "type": "string",
   "pattern": "^[a-z_]+(\\+stalker)?$"
  },
  "stats": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "hp",
    "atk",
    "def",
    "matk",
    "mdef",
    "spd"
   ],
   "properties": {
    "hp": {
     "type": "integer",
     "minimum": 1
    },
    "atk": {
     "type": "integer",
     "minimum": 0
    },
    "def": {
     "type": "integer",
     "minimum": 0
    },
    "matk": {
     "type": "integer",
     "minimum": 0
    },
    "mdef": {
     "type": "integer",
     "minimum": 0
    },
    "spd": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "xp": {
   "type": "integer",
   "minimum": 0
  },
  "gold": {
   "type": "integer",
   "minimum": 0
  },
  "attackIds": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^atk_[a-z0-9_]+$"
   }
  },
  "isUnique": {
   "type": "boolean"
  },
  "isTyrant": {
   "type": "boolean"
  },
  "ring": {
   "type": "integer",
   "minimum": 0,
   "maximum": 9
  },
  "habitats": {
   "type": "array",
   "minItems": 1,
   "maxItems": 5,
   "items": {
    "type": "string",
    "pattern": "^reg_[a-z0-9_]+$"
   }
  },
  "lootTableId": {
   "type": "string",
   "pattern": "^loot_[a-z0-9_]+$"
  },
  "signature": {
   "type": "string"
  },
  "look": {
   "type": "string",
   "minLength": 40
  },
  "fieldNote": {
   "type": "string"
  },
  "trope": {
   "type": "string"
  },
  "designRecipe": {
   "type": "object",
   "required": [
    "rigId",
    "parts",
    "material",
    "palette",
    "vfx",
    "animSetId"
   ],
   "properties": {
    "palette": {
     "type": "array",
     "minItems": 3,
     "maxItems": 3,
     "items": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
     }
    }
   }
  }
 }
}