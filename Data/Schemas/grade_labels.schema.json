{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Core and harvest grade display labels",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "notes",
  "grades",
  "materialCategories",
  "safeguards"
 ],
 "properties": {
  "notes": {
   "type": "string",
   "minLength": 1
  },
  "safeguards": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "grades": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "tier",
     "name",
     "itemRarity",
     "quality",
     "designUse"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^gradelabel_[a-z0-9_]+$"
     },
     "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "itemRarity": {
      "type": "string",
      "enum": [
       "Common",
       "Uncommon",
       "Rare",
       "Epic",
       "Legendary"
      ]
     },
     "quality": {
      "type": "string",
      "minLength": 1
     },
     "designUse": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "materialCategories": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "examples",
     "uses"
    ],
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1
     },
     "examples": {
      "type": "string",
      "minLength": 1
     },
     "uses": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}