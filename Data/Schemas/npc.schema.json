{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "NPC",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "name",
  "tier",
  "homeRegion",
  "role",
  "backstory"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^npc_[a-z0-9_]+$"
  },
  "name": {
   "type": "string"
  },
  "tier": {
   "type": "string",
   "enum": [
    "core",
    "major",
    "townsfolk"
   ]
  },
  "race": {
   "type": "string"
  },
  "homeRegion": {
   "type": "string",
   "pattern": "^reg_[a-z0-9_]+$"
  },
  "settlement": {
   "type": "string"
  },
  "role": {
   "type": "string"
  },
  "backstory": {
   "type": "string",
   "minLength": 20
  },
  "secret": {
   "type": "string"
  },
  "faction": {
   "type": "string"
  },
  "romanceable": {
   "type": "boolean"
  },
  "canDie": {
   "type": "boolean"
  },
  "relationships": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "npcId",
     "kind"
    ],
    "properties": {
     "npcId": {
      "type": "string",
      "pattern": "^npc_[a-z0-9_]+$"
     },
     "kind": {
      "type": "string"
     }
    }
   }
  },
  "states": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "flag",
     "note"
    ],
    "properties": {
     "flag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "name": {
      "type": "string"
     },
     "role": {
      "type": "string"
     },
     "settlement": {
      "type": "string"
     },
     "note": {
      "type": "string",
      "minLength": 5
     }
    }
   }
  },
  "schedule": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "part",
     "place"
    ],
    "properties": {
     "part": {
      "type": "string",
      "enum": [
       "morning",
       "day",
       "dusk",
       "night"
      ]
     },
     "place": {
      "type": "string",
      "minLength": 1
     },
     "days": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "Solenday",
        "Maelsday",
        "Thorsday",
        "Sylvasday",
        "Kaelsday",
        "Morrowsday",
        "Vexday"
       ]
      }
     }
    }
   }
  }
 }
}