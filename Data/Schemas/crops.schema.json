{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Home crops",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "notes",
  "skill",
  "qualityByRank",
  "crops"
 ],
 "properties": {
  "notes": {
   "type": "string"
  },
  "skill": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*$"
  },
  "qualityByRank": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "F",
    "E",
    "D",
    "C",
    "B",
    "A",
    "S",
    "SS",
    "SSS"
   ],
   "properties": {
    "F": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork"
     ]
    },
    "E": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork"
     ]
    },
    "D": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork"
     ]
    },
    "C": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork"
     ]
    },
    "B": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork"
     ]
    },
    "A": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork"
     ]
    },
    "S": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork"
     ]
    },
    "SS": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork"
     ]
    },
    "SSS": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork"
     ]
    }
   }
  },
  "crops": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "seedItem",
     "yieldItem",
     "yieldCount",
     "seedsBack",
     "growHours",
     "rank"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^crop_[a-z0-9_]+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "seedItem": {
      "type": "string",
      "pattern": "^itm_seed_[a-z0-9_]+$"
     },
     "yieldItem": {
      "type": "string",
      "pattern": "^itm_[a-z0-9_]+$"
     },
     "yieldCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
     },
     "seedsBack": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
     },
     "growHours": {
      "type": "number",
      "minimum": 1,
      "maximum": 240
     },
     "rank": {
      "type": "string",
      "enum": [
       "F",
       "E",
       "D",
       "C",
       "B",
       "A",
       "S",
       "SS",
       "SSS"
      ]
     }
    }
   }
  }
 }
}