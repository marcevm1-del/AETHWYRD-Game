{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Life skill ladders",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "notes",
  "ranks",
  "commissionFromRank",
  "xp",
  "skills"
 ],
 "properties": {
  "notes": {
   "type": "string"
  },
  "ranks": {
   "type": "array",
   "minItems": 9,
   "maxItems": 9,
   "items": {
    "type": "string",
    "enum": [
     "F",
     "E",
     "D",
     "C",
     "B",
     "A",
     "S",
     "SS",
     "SSS"
    ]
   }
  },
  "commissionFromRank": {
   "type": "string",
   "enum": [
    "F",
    "E",
    "D",
    "C",
    "B",
    "A",
    "S",
    "SS",
    "SSS"
   ]
  },
  "xp": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "xpToReach",
    "firstCraftMultiplier",
    "trivialRankGap",
    "trivialMultiplier",
    "minXp",
    "defaultRecipeXpByRank",
    "gatherXpPerNode"
   ],
   "properties": {
    "xpToReach": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "F",
      "E",
      "D",
      "C",
      "B",
      "A",
      "S",
      "SS",
      "SSS"
     ],
     "properties": {
      "F": {
       "type": "integer",
       "minimum": 0
      },
      "E": {
       "type": "integer",
       "minimum": 0
      },
      "D": {
       "type": "integer",
       "minimum": 0
      },
      "C": {
       "type": "integer",
       "minimum": 0
      },
      "B": {
       "type": "integer",
       "minimum": 0
      },
      "A": {
       "type": "integer",
       "minimum": 0
      },
      "S": {
       "type": "integer",
       "minimum": 0
      },
      "SS": {
       "type": "integer",
       "minimum": 0
      },
      "SSS": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "firstCraftMultiplier": {
     "type": "number",
     "minimum": 1,
     "maximum": 20
    },
    "trivialRankGap": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9
    },
    "trivialMultiplier": {
     "type": "number",
     "exclusiveMinimum": 0,
     "maximum": 1
    },
    "minXp": {
     "type": "integer",
     "minimum": 1
    },
    "defaultRecipeXpByRank": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "F",
      "E",
      "D",
      "C",
      "B",
      "A",
      "S",
      "SS",
      "SSS"
     ],
     "properties": {
      "F": {
       "type": "integer",
       "minimum": 1
      },
      "E": {
       "type": "integer",
       "minimum": 1
      },
      "D": {
       "type": "integer",
       "minimum": 1
      },
      "C": {
       "type": "integer",
       "minimum": 1
      },
      "B": {
       "type": "integer",
       "minimum": 1
      },
      "A": {
       "type": "integer",
       "minimum": 1
      },
      "S": {
       "type": "integer",
       "minimum": 1
      },
      "SS": {
       "type": "integer",
       "minimum": 1
      },
      "SSS": {
       "type": "integer",
       "minimum": 1
      }
     }
    },
    "gatherXpPerNode": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "F",
      "E",
      "D",
      "C",
      "B",
      "A",
      "S",
      "SS",
      "SSS"
     ],
     "properties": {
      "F": {
       "type": "integer",
       "minimum": 1
      },
      "E": {
       "type": "integer",
       "minimum": 1
      },
      "D": {
       "type": "integer",
       "minimum": 1
      },
      "C": {
       "type": "integer",
       "minimum": 1
      },
      "B": {
       "type": "integer",
       "minimum": 1
      },
      "A": {
       "type": "integer",
       "minimum": 1
      },
      "S": {
       "type": "integer",
       "minimum": 1
      },
      "SS": {
       "type": "integer",
       "minimum": 1
      },
      "SSS": {
       "type": "integer",
       "minimum": 1
      }
     }
    }
   }
  },
  "skills": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "kind",
     "station"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "kind": {
      "type": "string",
      "enum": [
       "craft",
       "gather",
       "deferred"
      ]
     },
     "station": {
      "type": [
       "string",
       "null"
      ]
     },
     "notes": {
      "type": "string"
     }
    }
   }
  }
 }
}