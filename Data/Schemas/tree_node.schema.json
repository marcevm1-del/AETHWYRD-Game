{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Attunement tree node (proposed)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "name",
  "kind",
  "cluster",
  "effect",
  "downside",
  "cost",
  "links",
  "x",
  "y"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^att_[a-z0-9_]+$"
  },
  "name": {
   "type": "string",
   "minLength": 1
  },
  "kind": {
   "type": "string",
   "enum": [
    "hub",
    "start",
    "small",
    "notable",
    "keystone",
    "bridge"
   ]
  },
  "cluster": {
   "type": "string",
   "minLength": 1
  },
  "effect": {
   "type": "string",
   "minLength": 1
  },
  "downside": {
   "type": "string"
  },
  "cost": {
   "type": "integer",
   "minimum": 0,
   "maximum": 5
  },
  "links": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^att_[a-z0-9_]+$"
   }
  },
  "x": {
   "type": "number"
  },
  "y": {
   "type": "number"
  },
  "classKey": {
   "type": "string"
  }
 }
}