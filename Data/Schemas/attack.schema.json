{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Attack",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "name",
  "kind",
  "power",
  "cooldownSec",
  "telegraph",
  "element"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^atk_[a-z0-9_]+$"
  },
  "name": {
   "type": "string"
  },
  "kind": {
   "type": "string",
   "enum": [
    "melee",
    "ranged",
    "aoe",
    "grab",
    "dash",
    "magic",
    "buff",
    "debuff",
    "summon",
    "counter",
    "heal",
    "evade",
    "stealth"
   ]
  },
  "power": {
   "type": "number",
   "minimum": 0
  },
  "cooldownSec": {
   "type": "number",
   "minimum": 0
  },
  "telegraph": {
   "type": "string",
   "enum": [
    "none",
    "blue",
    "red",
    "gold"
   ]
  },
  "element": {
   "type": "string",
   "enum": [
    "None",
    "Fire",
    "Water",
    "Ice",
    "Lightning",
    "Earth",
    "Wind",
    "Nature",
    "Poison",
    "Light",
    "Dark",
    "Blood",
    "Void"
   ]
  }
 }
}