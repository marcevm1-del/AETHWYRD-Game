{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Underworld layer registry (Wave F-lite)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "layers"
 ],
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "note": {
   "type": "string"
  },
  "layers": {
   "type": "array",
   "minItems": 5,
   "maxItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "layer",
     "regionId",
     "name",
     "rankMin",
     "rankMax",
     "ring",
     "gate"
    ],
    "properties": {
     "layer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "regionId": {
      "type": "string",
      "pattern": "^reg_[a-z0-9_]+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "rankMin": {
      "type": "string",
      "enum": [
       "F",
       "E",
       "D",
       "C",
       "B",
       "A",
       "S",
       "SS",
       "SSS",
       "EX"
      ]
     },
     "rankMax": {
      "type": "string",
      "enum": [
       "F",
       "E",
       "D",
       "C",
       "B",
       "A",
       "S",
       "SS",
       "SSS",
       "EX"
      ]
     },
     "ring": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
     },
     "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "at",
       "surfaceRegionId"
      ],
      "properties": {
       "at": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number",
         "minimum": 0,
         "maximum": 150
        }
       },
       "surfaceRegionId": {
        "type": "string",
        "pattern": "^reg_[a-z0-9_]+$"
       }
      }
     },
     "regionsJsonDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "labyrinthBackDoor": {
      "type": "string",
      "pattern": "^bd_\\d{3}$"
     },
     "weavePressure": {
      "type": "boolean"
     }
    }
   }
  }
 }
}