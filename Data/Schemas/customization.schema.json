      "type": "string",
      "enum": [
       "built",
       "planned"
      ]
     },
     "notes": {
      "type": "string"
     }
    }
   }
  },
  "sockets": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "bone",
     "position",
