      "type": "string"
     }
    }
   }
  },
  "weapons": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "weaponFamily",
     "held",
     "sheathed",
     "status"
    ],
    "properties": {
