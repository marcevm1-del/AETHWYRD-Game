      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
       "type": "number"
      }
     },
     "rotationEuler": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
       "type": "number"
      }
     }
    }
   }
  },
  "looks": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "family",
     "face",
     "hair",
     "build",
     "outfit",
     "palette",
     "accessories",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "family": {
      "type": "string",
      "enum": [
       "feminine",
       "masculine"
      ]
     },
     "face": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "hair": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "build": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "outfit": {
      "type": "object",
      "additionalProperties": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]*$"
      }
     },
     "palette": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "accessories": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]*$"
      }
     },
     "weapon": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
