{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Puzzle set (Wave E)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "tuning",
  "puzzles"
 ],
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "notes": {
   "type": "string"
  },
  "tuning": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "failsBeforeAssist"
   ],
   "properties": {
    "failsBeforeAssist": {
     "type": "integer",
     "minimum": 1,
     "maximum": 10
    }
   }
  },
  "puzzles": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "type",
     "name",
     "optional",
     "hints"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^pzl_[a-z0-9_]+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "optional": {
      "type": "boolean",
      "enum": [
       true
      ]
     },
     "hints": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "itemId",
       "count"
      ],
      "properties": {
       "itemId": {
        "type": "string",
        "pattern": "^itm_[a-z0-9_]+$"
       },
       "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9
       }
      }
     },
     "type": {
      "type": "string",
      "enum": [
       "lever_sequence",
       "pressure_plate",
       "rune_match"
      ]
     },
     "levers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]*$"
      }
     },
     "sequence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]*$"
      }
     },
     "plates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "weight"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "weight": {
         "type": "integer",
         "minimum": 1,
         "maximum": 99
        }
       }
      }
     },
     "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "weight"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "weight": {
         "type": "integer",
         "minimum": 1,
         "maximum": 99
        }
       }
      }
     },
     "glyphs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]*$"
      }
     },
     "sconces": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "start",
        "target"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "start": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "target": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "also": {
         "type": "array",
         "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
         }
        }
       }
      }
     }
    }
   }
  }
 }
}