{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Universal monster variations",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "notes",
  "rarityTiers",
  "stacking",
  "balanceRules",
  "variations"
 ],
 "properties": {
  "notes": {
   "type": "string",
   "minLength": 1
  },
  "balanceRules": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "stacking": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "maxVariations",
    "strengthByCount",
    "note"
   ],
   "properties": {
    "maxVariations": {
     "type": "integer",
     "minimum": 1,
     "maximum": 6
    },
    "strengthByCount": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     }
    },
    "note": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "rarityTiers": {
   "type": "array",
   "minItems": 5,
   "maxItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "tier",
     "label"
    ],
    "properties": {
     "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "label": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "variations": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "rarityTier",
     "rarityLabel",
     "effect",
     "subtypes",
     "statMods",
     "excludedLines",
     "exclusiveWith",
     "visualCue",
     "weaknessNote",
     "rankShift",
     "scriptedOnly"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^var_[a-z0-9_]+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "rarityTier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "rarityLabel": {
      "type": "string",
      "minLength": 1
     },
     "effect": {
      "type": "string",
      "minLength": 1
     },
     "subtypes": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "statMods": {
      "type": "object",
      "additionalProperties": {
       "type": "number",
       "minimum": 0.1,
       "maximum": 3
      },
      "properties": {
       "hp": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 3
       },
       "atk": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 3
       },
       "def": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 3
       },
       "matk": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 3
       },
       "mdef": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 3
       },
       "spd": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 3
       }
      }
     },
     "excludedLines": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^evl_[a-z0-9_]+$"
      }
     },
     "exclusiveWith": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^var_[a-z0-9_]+$"
      }
     },
     "element": {
      "type": "string",
      "minLength": 1
     },
     "visualCue": {
      "type": "string",
      "minLength": 1
     },
     "weaknessNote": {
      "type": "string",
      "minLength": 1
     },
     "rankShift": {
      "type": "integer",
      "enum": [
       0
      ]
     },
     "scriptedOnly": {
      "type": "boolean"
     },
     "note": {
      "type": "string",
      "minLength": 1
     },
     "existingModifier": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}