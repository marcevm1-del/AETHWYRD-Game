{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Item",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "name",
  "category"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^itm_[a-z0-9_]+$"
  },
  "name": {
   "type": "string",
   "minLength": 1
  },
  "category": {
   "type": "string",
   "enum": [
    "material",
    "core",
    "weapon",
    "armor",
    "accessory",
    "consumable",
    "key",
    "relic",
    "rune",
    "scroll",
    "part",
    "fragment"
   ]
  },
  "rank": {
   "type": "string",
   "enum": [
    "F",
    "E",
    "D",
    "C",
    "B",
    "A",
    "S",
    "SS",
    "SSS",
    "EX"
   ]
  },
  "rarity": {
   "type": "string",
   "enum": [
    "Common",
    "Uncommon",
    "Rare",
    "Epic",
    "Legendary",
    "Mythic",
    "Divine"
   ]
  },
  "slot": {
   "type": "string"
  },
  "weaponType": {
   "type": "string",
   "description": "weapons: must appear in a class weapons list"
  },
  "armorWeight": {
   "type": "string",
   "enum": [
    "cloth",
    "light",
    "medium",
    "heavy"
   ]
  },
  "value": {
   "type": "integer",
   "minimum": 0
  },
  "stats": {
   "type": "object"
  },
  "flavor": {
   "type": "string"
  },
  "setId": {
   "type": "string"
  },
  "meal": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "effects",
    "seconds"
   ],
   "description": "cooking buff (Well Fed slot)",
   "properties": {
    "effects": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "stat",
       "amount"
      ],
      "properties": {
       "stat": {
        "type": "string",
        "minLength": 1
       },
       "amount": {
        "type": "number"
       }
      }
     }
    },
    "seconds": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  }
 }
}