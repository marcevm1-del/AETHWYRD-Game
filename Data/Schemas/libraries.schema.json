{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Libraries, archives, temples, schools and guild halls",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "libraries"
 ],
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "note": {
   "type": "string"
  },
  "libraries": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "type",
     "region",
     "settlement",
     "status",
     "source",
     "blurb"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^lib_[a-z0-9_]+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "type": {
      "type": "string",
      "enum": [
       "library",
       "archive",
       "temple",
       "school",
       "guild_hall"
      ]
     },
     "region": {
      "type": "string",
      "pattern": "^reg_[a-z0-9_]+$"
     },
     "settlement": {
      "type": "string",
      "minLength": 1
     },
     "status": {
      "type": "string",
      "enum": [
       "canon",
       "proposed"
      ]
     },
     "source": {
      "type": "string",
      "minLength": 1
     },
     "blurb": {
      "type": "string",
      "minLength": 1
     },
     "covers": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^reg_[a-z0-9_]+$"
      }
     },
     "rankGate": {
      "type": "string",
      "enum": [
       "F",
       "E",
       "D",
       "C",
       "B",
       "A",
       "S",
       "SS",
       "SSS"
      ]
     }
    }
   }
  }
 }
}