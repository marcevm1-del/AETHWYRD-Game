{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "BossWeakPoints",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "notes",
  "bosses"
 ],
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "notes": {
   "type": "string"
  },
  "armorDamageByWeight": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "light",
    "medium",
    "heavy",
    "launch",
    "skill",
    "ultimate"
   ],
   "properties": {
    "light": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "medium": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "heavy": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "launch": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "skill": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "ultimate": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  },
  "bosses": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "speciesId",
     "armor",
     "weakPoints"
    ],
    "properties": {
     "speciesId": {
      "type": "string",
      "pattern": "^mon_[a-z0-9_]+$"
     },
     "armor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "maxArmor",
       "breakSec",
       "damageTakenMultWhileBroken",
       "regenDelaySec"
      ],
      "properties": {
       "maxArmor": {
        "type": "number",
        "minimum": 0
       },
       "breakSec": {
        "type": "number",
        "minimum": 0
       },
       "damageTakenMultWhileBroken": {
        "type": "number",
        "minimum": 1
       },
       "regenDelaySec": {
        "type": "number",
        "exclusiveMinimum": 0
       }
      }
     },
     "weakPoints": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "label",
        "bodyPart",
        "damageMult",
        "armorDamageMult",
        "exposedInPhases"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
         "type": "string",
         "minLength": 1
        },
        "bodyPart": {
         "type": "string",
         "minLength": 1
        },
        "damageMult": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "armorDamageMult": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "exposedInPhases": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "string",
          "minLength": 1
         }
        },
        "exposedSec": {
         "type": "number",
         "minimum": 0
        }
       }
      }
     }
    }
   }
  }
 }
}