{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Lair types, dungeon progression and world events",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "notes",
  "locationTypes",
  "progression",
  "worldEvents"
 ],
 "properties": {
  "notes": {
   "type": "string",
   "minLength": 1
  },
  "locationTypes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "inhabitantLines",
     "signatureFeatures"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^lair_[a-z0-9_]+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "inhabitantLines": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^evl_[a-z0-9_]+$"
      }
     },
     "signatureFeatures": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "progression": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "step",
     "id",
     "text"
    ],
    "properties": {
     "step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
     },
     "id": {
      "type": "string",
      "minLength": 1
     },
     "text": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "worldEvents": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "text",
     "lines",
     "requestedBy",
     "scope",
     "drivers"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^wev_[a-z0-9_]+$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "text": {
      "type": "string",
      "minLength": 1
     },
     "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^evl_[a-z0-9_]+$"
      }
     },
     "requestedBy": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^gld_[a-z0-9_]+$"
      }
     },
     "scope": {
      "type": "string",
      "enum": [
       "region"
      ]
     },
     "drivers": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    }
   }
  }
 }
}