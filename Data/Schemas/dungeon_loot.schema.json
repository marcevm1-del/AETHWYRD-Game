{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Dungeon loot",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "notes",
  "tables",
  "caches"
 ],
 "properties": {
  "notes": {
   "type": "string"
  },
  "tables": {
   "type": "array",
   "minItems": 1,
   "items": {
    "title": "Loot table",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "entries"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^loot_[a-z0-9_]+$"
     },
     "family": {
      "type": "string"
     },
     "rank": {
      "type": "string",
      "enum": [
       "F",
       "E",
       "D",
       "C",
       "B",
       "A",
       "S",
       "SS",
       "SSS",
       "EX"
      ]
     },
     "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "itemId",
        "chance",
        "min",
        "max"
       ],
       "properties": {
        "itemId": {
         "type": "string",
         "pattern": "^itm_[a-z0-9_]+$"
        },
        "chance": {
         "type": "number",
         "minimum": 0.000001,
         "maximum": 1
        },
        "min": {
         "type": "integer",
         "minimum": 0
        },
        "max": {
         "type": "integer",
         "minimum": 1
        }
       }
      }
     }
    }
   }
  },
  "caches": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "dungeonId",
     "roomId",
     "kind",
     "tableId",
     "rolls",
     "once"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^cache_[a-z0-9_]+$"
     },
     "dungeonId": {
      "type": "string",
      "pattern": "^dng_[a-z0-9_]+$"
     },
     "roomId": {
      "type": "string",
      "pattern": "^rm_[a-z0-9_]+$"
     },
     "kind": {
      "type": "string",
      "enum": [
       "salvage_pile",
       "chest",
       "boss_cache",
       "secret_chest"
      ]
     },
     "tableId": {
      "type": "string",
      "pattern": "^loot_[a-z0-9_]+$"
     },
     "rolls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
     },
     "once": {
      "type": "boolean"
     },
     "label": {
      "type": "string"
     }
    }
   }
  }
 }
}