{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Story flag",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "description",
  "setBy"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*$"
  },
  "description": {
   "type": "string",
   "minLength": 5
  },
  "setBy": {
   "type": "string",
   "enum": [
    "quest",
    "story",
    "system"
   ]
  }
 }
}