{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Monster evolution lines",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "notes",
  "stageGrammar",
  "conditionKinds",
  "forbiddenTriggers",
  "patterns",
  "specializationFamilies",
  "fusionRules",
  "fusions",
  "groups"
 ],
 "properties": {
  "notes": {
   "type": "string",
   "minLength": 1
  },
  "stageGrammar": {
   "type": "array",
   "minItems": 9,
   "maxItems": 9,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "conditionKinds": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "text"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "text": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "forbiddenTriggers": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "patterns": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "text"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "text": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "specializationFamilies": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "text"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "text": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "fusionRules": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "requiresCatalyst",
    "requiresStableEnergy",
    "requiresCost",
    "onlyListedPairs"
   ],
   "properties": {
    "requiresCatalyst": {
     "type": "boolean"
    },
    "requiresStableEnergy": {
     "type": "boolean"
    },
    "requiresCost": {
     "type": "boolean"
    },
    "onlyListedPairs": {
     "type": "boolean"
    }
   }
  },
  "fusions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "a",
     "b",
     "result",
     "note"
    ],
    "properties": {
     "a": {
      "type": "string",
      "pattern": "^evl_[a-z0-9_]+$"
     },
     "b": {
      "type": "string",
      "pattern": "^evl_[a-z0-9_]+$"
     },
     "result": {
      "type": "string",
      "minLength": 1
     },
     "note": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "groups": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "order",
     "name",
     "bibleFamily",
     "familyKeys",
     "identity",
     "stages",
     "branches",
     "variants",
     "signatureAbilities",
     "society"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^evl_[a-z0-9_]+$"
     },
     "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "bibleFamily": {
      "type": "string",
      "minLength": 1
     },
     "familyKeys": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "identity": {
      "type": "string",
      "minLength": 1
     },
     "stages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "stage",
        "label"
       ],
       "properties": {
        "stage": {
         "type": "integer",
         "minimum": 1,
         "maximum": 9
        },
        "label": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     },
     "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "signatureAbilities": {
      "type": "string",
      "minLength": 1
     },
     "society": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}