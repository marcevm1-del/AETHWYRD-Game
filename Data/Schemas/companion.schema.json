{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Companion roster row",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "name",
  "kind",
  "race",
  "personalityTags",
  "roleTags",
  "preferredRole",
  "presetDefault",
  "romanceable",
  "adult",
  "equipmentSlots",
  "rideable",
  "partyRole",
  "sourceDoc"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^cmp_[a-z0-9_]+$"
  },
  "name": {
   "type": "string",
   "minLength": 1
  },
  "kind": {
   "type": "string",
   "enum": [
    "companion",
    "childhoodFriend"
   ]
  },
  "npcId": {
   "type": "string",
   "pattern": "^npc_[a-z0-9_]+$"
  },
  "race": {
   "type": "string",
   "minLength": 1
  },
  "personalityTags": {
   "type": "array",
   "maxItems": 4,
   "items": {
    "type": "string",
    "enum": [
     "brave",
     "cautious",
     "curious",
     "loyal",
     "proud",
     "gentle",
     "playful",
     "stoic",
     "greedy",
     "serene"
    ]
   }
  },
  "roleTags": {
   "type": "array",
   "minItems": 1,
   "maxItems": 2,
   "items": {
    "type": "string",
    "enum": [
     "Vanguard",
     "Guardian",
     "Skirmisher",
     "Ranger",
     "Arcanist",
     "Mender",
     "Tamer",
     "Specialist"
    ]
   }
  },
  "preferredRole": {
   "type": "string",
   "enum": [
    "Vanguard",
    "Guardian",
    "Skirmisher",
    "Ranger",
    "Arcanist",
    "Mender",
    "Tamer",
    "Specialist"
   ]
  },
  "presetDefault": {
   "type": "string",
   "enum": [
    "Aggressive",
    "Defensive",
    "Supportive",
    "Balanced"
   ]
  },
  "romanceable": {
   "type": "boolean"
  },
  "adult": {
   "type": "boolean"
  },
  "redeemableArc": {
   "type": "boolean"
  },
  "equipmentSlots": {
   "type": "array",
   "minItems": 1,
   "maxItems": 4,
   "items": {
    "type": "string",
    "enum": [
     "weapon",
     "armor",
     "accessory",
     "charm"
    ]
   }
  },
  "rideable": {
   "type": "boolean",
   "enum": [
    false
   ]
  },
  "partyRole": {
   "type": "string",
   "minLength": 1
  },
  "sourceDoc": {
   "type": "string",
   "minLength": 1
  },
  "stub": {
   "type": "boolean"
  },
  "note": {
   "type": "string"
  }
 }
}