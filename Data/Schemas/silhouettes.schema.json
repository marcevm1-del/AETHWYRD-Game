{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Character silhouette library",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "categories",
  "axes",
  "silhouettes"
 ],
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "notes": {
   "type": "string"
  },
  "categories": {
   "type": "array",
   "minItems": 10,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "axes": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "minItems": 2,
    "items": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]*$"
    }
   }
  },
  "silhouettes": {
   "type": "array",
   "minItems": 60,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "family",
     "category",
     "shape",
     "readsAs"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^sil_[fm]_[0-9]{2}$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "family": {
      "type": "string",
      "enum": [
       "feminine",
       "masculine"
      ]
     },
     "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "readsAs": {
      "type": "string",
      "minLength": 10
     },
     "shape": {
      "type": "object",
      "additionalProperties": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]*$"
      }
     },
     "uses": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]*$"
      }
     },
     "notes": {
      "type": "string"
     }
    }
   }
  }
 }
}