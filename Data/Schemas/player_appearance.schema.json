{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Player appearance options (Phase 1B character creator)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "maxNameLength",
  "defaultName",
  "suggestedNames",
  "raceOriginNote",
  "bodies",
  "hairStyles",
  "hairColours",
  "skinTones",
  "outfitColours"
 ],
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "notes": {
   "type": "string"
  },
  "maxNameLength": {
   "type": "integer",
   "minimum": 4,
   "maximum": 32
  },
  "defaultName": {
   "type": "string",
   "minLength": 1
  },
  "suggestedNames": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "raceOriginNote": {
   "type": "string",
   "minLength": 1
  },
  "bodies": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "torsoWidth",
     "hipWidth"
    ],
    "properties": {
     "id": {
      "type": "string",
      "enum": [
       "masculine",
       "feminine"
      ]
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "torsoWidth": {
      "type": "number",
      "minimum": 0.6,
      "maximum": 1.4
     },
     "hipWidth": {
      "type": "number",
      "minimum": 0.6,
      "maximum": 1.4
     }
    }
   }
  },
  "hairStyles": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "hairColours": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "hex"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
     }
    }
   }
  },
  "skinTones": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "hex"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
     }
    }
   }
  },
  "outfitColours": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "hex"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
     }
    }
   }
  }
 }
}