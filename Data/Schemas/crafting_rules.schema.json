{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Crafting quality rules",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "notes",
  "qualityTiers",
  "formula",
  "rankQualityCap",
  "stationQualityCap"
 ],
 "properties": {
  "notes": {
   "type": "string"
  },
  "qualityTiers": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "index",
     "statMult",
     "valueMult",
     "buffMult",
     "mark",
     "nameable",
     "craftable"
    ],
    "properties": {
     "id": {
      "type": "string",
      "enum": [
       "poor",
       "normal",
       "fine",
       "superior",
       "masterwork",
       "legendary"
      ]
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
     },
     "statMult": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1.3
     },
     "valueMult": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "buffMult": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "mark": {
      "type": "boolean"
     },
     "nameable": {
      "type": "boolean"
     },
     "craftable": {
      "type": "boolean"
     }
    }
   }
  },
  "formula": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "skillBonusPerRank",
    "experimentBonus",
    "jitterMax",
    "tierAboveBest"
   ],
   "properties": {
    "skillBonusPerRank": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "experimentBonus": {
     "type": "number",
     "minimum": 0,
     "maximum": 2
    },
    "jitterMax": {
     "type": "number",
     "minimum": 0,
     "maximum": 0.99
    },
    "tierAboveBest": {
     "type": "integer",
     "minimum": 0,
     "maximum": 5
    }
   }
  },
  "rankQualityCap": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "F",
    "E",
    "D",
    "C",
    "B",
    "A",
    "S",
    "SS",
    "SSS"
   ],
   "properties": {
    "F": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "E": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "D": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "C": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "B": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "A": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "S": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "SS": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "SSS": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    }
   }
  },
  "stationQualityCap": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "campfire",
    "forge",
    "alembic",
    "loom",
    "tannery",
    "hearth",
    "brewery",
    "jewelers_bench"
   ],
   "properties": {
    "campfire": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "forge": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "alembic": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "loom": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "tannery": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "hearth": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "brewery": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    },
    "jewelers_bench": {
     "type": "string",
     "enum": [
      "poor",
      "normal",
      "fine",
      "superior",
      "masterwork",
      "legendary"
     ]
    }
   }
  }
 }
}